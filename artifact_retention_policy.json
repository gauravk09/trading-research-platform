{
  "version": 1,
  "policy": "inventory_only_no_deletion",
  "areas": [
    {"path": "data/parquet", "category": "canonical_keep", "action": "keep", "reason": "Canonical processed market inputs."},
    {"path": "output/state", "category": "canonical_keep", "action": "keep", "reason": "Daily trading state audit trail."},
    {"path": "output/grader", "category": "canonical_keep", "action": "keep", "reason": "Forward-test grading record."},
    {"path": "output/paper_broker", "category": "canonical_keep", "action": "keep", "reason": "Paper broker journal and summaries."},
    {"path": "output/rehearsals", "category": "canonical_keep", "action": "keep", "reason": "Execution rehearsal audit evidence."},
    {"path": "output/mlflow", "category": "canonical_keep", "action": "keep", "reason": "Local experiment metadata index."},
    {"path": "research/factory/LEDGER.md", "category": "canonical_keep", "action": "keep", "reason": "Append-only promotion authority."},
    {"path": "research/factory", "category": "canonical_keep", "action": "keep", "reason": "Pre-registered specs and factory evidence."},
    {"path": "research/machine/specs", "category": "canonical_keep", "action": "keep", "reason": "Machine experiment specifications are protected evidence."},
    {"path": "data/raw/surveillance", "category": "raw_source", "action": "keep", "reason": "Raw source records are retained for provenance."},
    {"path": "output/chart_bank", "category": "generated_reports", "action": "review_move", "min_age_days": 30, "reason": "Rebuildable charts; review before moving old files."},
    {"path": "research/output/_cache", "category": "rebuildable_cache", "action": "review_move", "min_age_days": 30, "reason": "Rebuildable research cache; review before moving old files."},
    {"path": "data/raw/_pre_migration_trash", "category": "review_required", "action": "review_move", "min_age_days": 0, "reason": "Pre-migration material requires manual provenance review."},
    {"path": "logs", "glob": "**/*.log", "category": "generated_reports", "action": "compress_candidate", "min_age_days": 30, "reason": "Old logs may be compressed after review."},
    {"path": "webapp/frontend/node_modules", "category": "rebuildable_cache", "action": "review_move", "min_age_days": 0, "reason": "Reinstallable frontend dependency tree."},
    {"path": "alpha_forge/backtest_reports", "category": "archived_exploration", "action": "review_move", "min_age_days": 30, "reason": "Archived exploration reports; review before moving."},
    {"path": "data/raw/financials", "category": "review_required", "action": "keep", "reason": "Large raw financial archive: keep until a separate dedupe audit."}
  ]
}
